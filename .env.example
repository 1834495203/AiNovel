POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://novel:change-me@localhost:5432/novel
REDIS_URL=redis://localhost:6379/0
# 运行 ainovel set-password 设置访问密码；保存哈希，不保存明文。留空时不启用密码。
ACCESS_PASSWORD_HASH=
ACCESS_SESSION_SECRET=
ACCESS_SESSION_HOURS=12
# openai 表示使用 OpenAI 兼容协议；mock 可离线演示。
LLM_PROVIDER=openai
# 也兼容 LLM_BASE_URL / LLM_API_KEY；不要同时设置两套值。
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek 具名强制工具调用需要关闭 thinking。
LLM_THINKING=disabled
# 每次生成的输出上限；格式无效时最多重试两次，每次均记录耗时和 token。
LLM_MAX_TOKENS=8192
LLM_OUTPUT_RETRIES=2
# 向量供应商独立于写作模型。hash 本地运行，不向 DeepSeek 请求 embedding。
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 每轮 agent loop 的模型调用上限；完成任务后立即结束，不补跑额外步骤。
AGENT_MAX_STEPS=6
