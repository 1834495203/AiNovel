{%- macro value(item) -%}
{% if item is mapping -%}
{% for key, child in item.items() %}{{ key }}为{{ value(child) }}{% if not loop.last %}，{% endif %}{% else %}无{% endfor %}
{%- elif item is sequence and item is not string -%}
{% for child in item %}{{ value(child) }}{% if not loop.last %}、{% endif %}{% else %}无{% endfor %}
{%- elif item is boolean -%}
{{ '是' if item else '否' }}
{%- elif item is none -%}
未设置
{%- else -%}
{{ item }}
{%- endif %}
{%- endmacro -%}
{%- macro fields(entity) %}
{% for description in entity.description if description.value -%}
- {{ description.name }}{% if description.visibility != 2 %}（{% if description.visibility == 0 %}仅 GM{% else %}角色私密{% endif %}）{% endif %}：{{ description.value | join('；') }}
{% endfor -%}
{% for attribute in entity.special_attributes -%}
- {{ attribute.key }}{% if attribute.visibility != 2 %}（{% if attribute.visibility == 0 %}仅 GM{% else %}角色私密{% endif %}）{% endif %}：{{ value(attribute.current_value) }}
{% if attribute.why %}。用途：{{ attribute.why }}{% endif -%}
{% if attribute.how %}。叙事表现：{{ attribute.how }}{% endif -%}
{% if attribute.when %}。修改条件：{{ attribute.when }}{% endif %}
{% endfor -%}
{% endmacro -%}
{%- macro events(items, show_ids=false) -%}
{% for event in items -%}
- {% if show_ids %}#{{ event.position }} {% endif %}{{ event.label }}
{%- if event.speaker %} · {{ event.speaker }}{% endif -%}
{% if event.character and event.kind != 'role' %} · {{ event.character.name }}{% endif -%}
{% if event.kind in ('gm_direction', 'self_edit') %}（接收者：{{ event.audience | map(attribute='name') | join('、') }}）{% endif %}：{{ event.text }}
{% endfor -%}
{% endmacro -%}
